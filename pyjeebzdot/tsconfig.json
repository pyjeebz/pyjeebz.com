{
  "extends": "astro/tsconfigs/strict",
  // tsx (esbuild) does not follow `extends`, so the JSX runtime must be
  // declared here for scripts/generate-og.tsx to compile correctly.
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
