---
import ThemeToggle from "../components/ThemeToggle.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
import WhipTrail from "../components/WhipTrail.astro";

import "../styles/global.css";

interface Props {
  title: string;
  /** Set false to drop the name + "build things" masthead on a page. */
  showHeader?: boolean;
  /** Widen the column — the guestbook wall needs more room than the index. */
  wide?: boolean;
  /** Drop the column entirely so a page can run full-bleed. */
  bleed?: boolean;
}

const { title, showHeader = true, wide = false, bleed = false } = Astro.props;

const romanYear = (() => {
  const vals: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"], [100, "C"],
    [90, "XC"], [50, "L"], [40, "XL"], [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let r = "", y = new Date().getFullYear();
  for (const [v, s] of vals) while (y >= v) { r += s; y -= v; }
  return r;
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="description" content="Mujeeb's corner of the internet. Mostly held together with code and optimism." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content="pyjeebz" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pyjeebz.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Mujeeb's corner of the internet. Mostly held together with code and optimism." />
    <meta property="og:image" content="/card-preview.jpeg" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://pyjeebz.com" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content="Mujeeb's corner of the internet. Mostly held together with code and optimism." />
    <meta property="twitter:image" content="/card-preview.jpeg" />

    <script is:inline>
      // Applied before paint so the chosen theme never flashes.
      (function () {
        var root = document.documentElement;
        var saved = null;
        try { saved = localStorage.getItem("pj-theme"); } catch (e) {}
        var light =
          saved === "light" ||
          (!saved && window.matchMedia("(prefers-color-scheme: light)").matches);
        if (light) root.classList.add("light");

        function paintMeta() {
          var m = document.querySelector('meta[name="theme-color"]');
          if (!m) return;
          var bg = getComputedStyle(root).getPropertyValue("--bg").trim();
          if (bg) m.setAttribute("content", bg);
        }

        window.__pjTheme = {
          isLight: function () { return root.classList.contains("light"); },
          toggle: function () {
            var isLight = root.classList.toggle("light");
            try { localStorage.setItem("pj-theme", isLight ? "light" : "dark"); } catch (e) {}
            paintMeta();
            try { window.dispatchEvent(new CustomEvent("pj:theme")); } catch (e) {}
            return isLight;
          },
        };
        document.addEventListener("DOMContentLoaded", paintMeta);
      })();
    </script>

  </head>
  <body class="bg-black-001 text-off-white min-h-screen antialiased">
    <div
      class:list={[
        "mx-auto flex min-h-screen w-full flex-col",
        bleed
          ? "max-w-none px-4 py-8 sm:px-6"
          : ["px-6 py-16 sm:py-20", wide ? "max-w-3xl" : "max-w-[26rem]"],
      ]}
    >
      <main class="min-w-0 flex-1">
        {showHeader && <SiteHeader home={Astro.url.pathname === "/"} />}
        <slot />
      </main>
      <footer
        class="mt-16 pt-6 border-t border-hairline flex flex-wrap items-center justify-between gap-x-6 gap-y-3"
      >
        <SocialLinks />
        <div class="flex items-center gap-4">
          <p class="font-mono text-2xs uppercase tracking-[0.14em] text-muted-faint">
            © {romanYear}
          </p>
          <ThemeToggle />
        </div>
      </footer>
    </div>

    <WhipTrail />
  </body>
</html>
