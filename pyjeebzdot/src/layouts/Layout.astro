---
import SiteHeader from "../components/SiteHeader.astro";
import DrawnLine from "../components/napkin/DrawnLine.astro";

import "../styles/global.css";

interface Props {
  title: string;
  /** Set false to drop the name + tagline masthead on a page. */
  showHeader?: boolean;
  /** Widen the column for pages that need more room than the index. */
  wide?: boolean;
  /** Drop the column entirely so a page can run full-bleed. */
  bleed?: boolean;
  /**
   * The page owns the whole viewport (e.g. the signature wall canvas):
   * no padding, no masthead, no footer.
   */
  bare?: boolean;
}

const { title, showHeader = true, wide = false, bleed = false, bare = false } = Astro.props;

const romanYear = (() => {
  const vals: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"], [100, "C"],
    [90, "XC"], [50, "L"], [40, "XL"], [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let r = "", y = new Date().getFullYear();
  for (const [v, s] of vals) while (y >= v) { r += s; y -= v; }
  return r;
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" content="#F4F1EA" />
    <meta name="description" content="Mujeeb's corner of the internet. Mostly held together with code and optimism." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content="pyjeebz" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Kalam:wght@300;400;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pyjeebz.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Mujeeb's corner of the internet. Mostly held together with code and optimism." />
    <meta property="og:image" content="/card-preview.jpeg" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://pyjeebz.com" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content="Mujeeb's corner of the internet. Mostly held together with code and optimism." />
    <meta property="twitter:image" content="/card-preview.jpeg" />

    <script>
      import "../scripts/napkin";
    </script>

  </head>
  <body class="paper-texture bg-paper text-charcoal font-body min-h-screen antialiased">
    <div
      class:list={[
        "min-h-screen flex flex-col",
        bare
          ? "max-w-none"
          : `max-w-2xl mx-auto px-6 sm:px-8 py-12 sm:py-16 md:py-20 ${bleed ? "max-w-none" : wide ? "max-w-3xl" : ""}`,
      ]}
    >
      <main class="min-w-0 flex-1">
        {showHeader && !bare && <SiteHeader home={Astro.url.pathname === "/"} />}
        <slot />
      </main>
      {!bare && (
        <footer class="mt-20 text-2xs uppercase tracking-[0.18em] text-muted-faint">
          <DrawnLine class="mb-5 opacity-50" />
          <p class="flex items-center gap-x-3">
            <span>© {romanYear}</span>
            <span class="text-muted-faint/35 select-none" aria-hidden="true">·</span>
            <span>Mujeeb</span>
          </p>
        </footer>
      )}
    </div>
  </body>
</html>