---
import Layout from "../layouts/Layout.astro";
import Highlighter from "../components/napkin/Highlighter.astro";
import GuestbookWrapper from "../components/react/GuestbookWrapper";

export const prerender = true;
---

<Layout title="guestbook - Mujeeb" wide>
  <div class="mb-10">
    <h1 class="font-display text-[clamp(1.75rem,5vw,2.25rem)] font-normal text-charcoal tracking-tight">
      sign the <Highlighter color="yellow">napkin</Highlighter>
    </h1>
  </div>

  <GuestbookWrapper client:only="react" />
</Layout>