---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import DrawnLine from "../../components/napkin/DrawnLine.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="ramblings - Mujeeb">
  <div class="mb-12">
    <h1 class="font-display text-[clamp(1.75rem,5vw,2.25rem)] font-normal text-charcoal tracking-tight">
      ramblings
    </h1>
    <DrawnLine class="mt-4 w-44" />
  </div>

  {
    posts.length === 0 ? (
      <div class="flex flex-col items-center justify-center py-20">
        <p class="text-muted text-lg italic">Coming soon.</p>
      </div>
    ) : (
      <ul>
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group block py-6 border-b border-charcoal/10 last:border-b-0"
            >
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
                <span
                  data-napkin="underline"
                  class="font-display text-lg text-charcoal leading-snug w-fit"
                >
                  {post.data.title}
                </span>
                <span class="shrink-0 font-mono text-2xs uppercase tracking-[0.14em] text-muted-faint">
                  {fmt(post.data.date)}
                </span>
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-muted max-w-xl">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>