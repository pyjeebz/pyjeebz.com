---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="blog - Mujeeb">
  <h1
    class="font-serif text-[clamp(1.75rem,5vw,2.25rem)] font-medium text-off-white tracking-tight mb-10 pb-6 border-b border-hairline"
  >
    blog
  </h1>

  {
    posts.length === 0 ? (
      <div class="flex flex-col items-center justify-center py-20">
        <p class="text-muted text-lg font-serif italic">Coming soon.</p>
      </div>
    ) : (
      <ul>
        {posts.map((post) => (
          <li class="border-b border-hairline last:border-b-0">
            <a
              href={`/blog/${post.slug}`}
              class="group block py-6 -mx-1 px-1 sm:px-2 -ml-2 sm:-ml-3 border-l-2 border-transparent hover:border-accent/55 pl-3 sm:pl-4 transition-colors"
            >
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
                <span class="font-serif text-[1.05rem] sm:text-lg text-off-white group-hover:text-accent transition-colors">
                  {post.data.title}
                </span>
                <span class="shrink-0 font-mono text-2xs uppercase tracking-[0.14em] text-muted-faint">
                  {fmt(post.data.date)}
                </span>
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-muted max-w-xl">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
