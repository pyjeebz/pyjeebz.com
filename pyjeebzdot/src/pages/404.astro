---
import Layout from "../layouts/Layout.astro";
import { MLSSignature } from "../components/MLSSignature";
---

<Layout title="Page not found | Mujeeb" noIndex={true}>
  <header class="mb-5">
    <MLSSignature crossedOut client:load />
    <h1 class="mt-3 mb-0.5">Page not found</h1>
    <p class="text-zinc-500">
      This isn’t the page you signed up for.
    </p>
  </header>

  <p class="text-zinc-600">
    Head back to the <a
      href="/"
      data-cuelume-toggle="page"
      class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
      >Index</a
    >, read my <a
      href="/writings"
      data-cuelume-toggle="page"
      class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
      >Writings</a
    >, or browse the <a
      href="/projects"
      data-cuelume-toggle="page"
      class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
      >Projects</a
    > I’ve built.
  </p>
</Layout>
