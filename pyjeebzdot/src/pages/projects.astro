---
import Layout from "../layouts/Layout.astro";
import { BackButton } from "../components/BackButton";
import ProjectList from "../components/ProjectList.astro";

const projects = [
  {
    name: "PreScale",
    tagline: "The load tester that tells you why",
    href: "https://prescale.dev/",
  },
  {
    name: "ports",
    tagline: "Know what’s on your ports. Free or kill by name",
    href: "https://ports.tools/",
  },
  {
    name: "Toss",
    tagline: "Toss text between paired devices",
    href: "https://toss.pyjeebz.com/",
  },
  {
    name: "why",
    tagline: "git blame tells you who. why tells you why",
    href: "https://github.com/pyjeebz/why",
  },
  {
    name: "predict",
    tagline: "ML-powered auto-scaling for e-commerce",
    href: "https://github.com/pyjeebz/predict",
  },
  {
    name: "breakwatch",
    tagline: "OpenAPI breaking-change detector",
    href: "https://github.com/pyjeebz/breakwatch",
  },
  {
    name: "statewatch",
    tagline: "GCP drift detection with blast radius",
    href: "https://github.com/pyjeebz/statewatch",
  },
];
---

<Layout
  title="Projects | Mujeeb"
  description="Mujeeb’s projects and experiments."
>
  <header class="mb-8">
    <BackButton href="/" label="Index" />
    <h1 class="mt-8">Projects</h1>
    <p class="mt-1 text-zinc-500">
      Listed below are the projects I’ve participated in, dedicating significant
      time and effort towards their creation, maintenance, and enhancement.
    </p>
  </header>

  <ProjectList projects={projects} />
</Layout>
