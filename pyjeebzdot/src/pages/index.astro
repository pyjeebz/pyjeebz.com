---
import Layout from "../layouts/Layout.astro";
import { MoreInline } from "../components/MoreInline";
import { SoundToggle } from "../components/SoundToggle";
---

<Layout isHomePage={true}>
  <header class="mb-5">
    <h1 class="mb-0.5">Hey, I’m Mujeeb.</h1>
    <p class="text-zinc-500">You can call me “Jeebz”</p>
  </header>

  <div class="mb-8 space-y-3">
    <p>
      I’m a Software Engineer interested in research, systems, and anything
      computational based in Canada. I reverse-engineer complex challenges and
      reverse-code them into elegant solutions <MoreInline client:load
        >(computational thinker)</MoreInline
      >.
    </p>

    <p>
      Currently, I am exploring every aspect of computing. I make research on
      problems and I build solutions for it <MoreInline client:load
        >(interested in robotics, search, infrastructure, and AI/ML)</MoreInline
      >.
    </p>
  </div>

  <div class="mt-8 space-y-3">
    <p class="text-zinc-600">
      Read my <a
        href="/writings"
        data-cuelume-toggle="page"
        class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >writings</a
      >, browse the <a
        href="/projects"
        data-cuelume-toggle="page"
        class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >projects</a
      > I’ve built, or sign my <a
        href="/guestbook"
        data-cuelume-toggle="page"
        class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >guestbook</a
      >. Wanna discuss a project or just say hi? <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://cal.com/pyjeebz"
        data-cuelume-hover="tick"
        class="underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >Let’s grab a tea</a
      >, I don’t drink coffee.
    </p>

    <p class="text-zinc-600">
      You can find me on <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://x.com/pyjeebz"
        data-cuelume-hover="tick"
        class="-mx-3 px-3 py-3 text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >X</a
      >, <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/pyjeebz"
        data-cuelume-hover="tick"
        class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >GitHub</a
      >, or reach me via <a
        href="mailto:lawalsakamujeeb@gmail.com"
        data-cuelume-hover="tick"
        class="text-black underline decoration-zinc-300 underline-offset-2 hover:no-underline"
        >email</a
      >.
    </p>

    <SoundToggle client:load />
  </div>
</Layout>
