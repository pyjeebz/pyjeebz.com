---
interface Props {
  /** Highlighter wash behind the tag. */
  color?: "yellow" | "pink" | "blue" | "green" | "white" | "transparent";
  /** outline (default) | scribble */
  variant?: "outline" | "scribble";
  /** Tilt in degrees. Omit for a random -2..2 pick per render. */
  rotate?: number;
  class?: string;
  [key: string]: unknown;
}

const { color = "yellow", variant = "outline", rotate, class: className, ...rest } = Astro.props;

const tilt = rotate ?? (Math.floor(Math.random() * 5) - 2);

const fillVar: Record<string, string> = {
  yellow: "var(--highlighter-yellow)",
  pink: "var(--highlighter-pink)",
  blue: "var(--highlighter-blue)",
  green: "var(--highlighter-green)",
  white: "#FFFFFF",
  transparent: "transparent",
};
---

<span
  data-napkin="badge"
  data-napkin-opts={JSON.stringify({ variant })}
  style={`--drawably-fill: ${fillVar[color]}; transform: rotate(${tilt}deg); display: inline-block;`}
  class:list={["font-mono text-2xs uppercase tracking-[0.08em] px-2 py-0.5", className]}
  {...rest}
>
  <slot />
</span>