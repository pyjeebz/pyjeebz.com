---
// The sound toggle: a speaker whose waves (or cross) draw themselves in and
// out, and a label that swaps with a small rise. Plain CSS and a few lines of
// script, so the home page ships no framework for it. Sound is off until the
// visitor turns it on (lib/sound.ts); `M` toggles it from anywhere.
---

<button
  type="button"
  class="sound mt-4 inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-[color,scale] duration-150 outline-none hover:text-black focus-visible:ring focus-visible:ring-zinc-300 active:scale-[0.96]"
  aria-pressed="false"
  aria-keyshortcuts="m"
  title="Turn sound on (press M)"
  data-sound-toggle
  data-muted
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M11 5 6 9H2v6h4l5 4z"></path>
    <g class="off">
      <line pathLength="1" x1="23" y1="9" x2="17" y2="15"></line>
      <line pathLength="1" x1="17" y1="9" x2="23" y2="15"></line>
    </g>
    <g class="on">
      <path pathLength="1" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      <path pathLength="1" d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
    </g>
  </svg>
  <span class="labels grid">
    <span class="label-off">Sound off</span>
    <span class="label-on">Sound on</span>
  </span>
</button>

<style>
  /* Strokes draw along their length (pathLength 1). The leaving pair goes
     first, last stroke first; then the arriving pair draws in, one after the
     other. */
  g > * {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 0.22s cubic-bezier(0.16, 1, 0.3, 1) 0.16s,
      opacity 0.22s 0.16s;
  }
  g > :nth-child(2) {
    transition-delay: 0.22s;
  }
  .sound[data-muted] .on > *,
  .sound:not([data-muted]) .off > * {
    stroke-dashoffset: 1;
    opacity: 0;
    transition-duration: 0.16s;
    transition-delay: 0.04s;
  }
  .sound[data-muted] .on > :nth-child(2),
  .sound:not([data-muted]) .off > :nth-child(2) {
    transition-delay: 0s;
  }

  /* Both labels share one cell; the leaving one fades up and away, the
     arriving one rises into place. */
  .labels > * {
    grid-area: 1 / 1;
    transition:
      opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sound[data-muted] .label-on,
  .sound:not([data-muted]) .label-off {
    opacity: 0;
    translate: 0 -4px;
  }
  .sound[data-ready][data-muted] .label-off,
  .sound[data-ready]:not([data-muted]) .label-on {
    animation: label-in 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes label-in {
    from {
      opacity: 0;
      translate: 0 4px;
    }
  }

  /* Until the script has set the real state, nothing animates into it. */
  .sound:not([data-ready]) *,
  .sound:not([data-ready]) {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .sound,
    .sound * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { sound } from "../lib/sound";

  for (const button of document.querySelectorAll<HTMLElement>(
    "[data-sound-toggle]",
  )) {
    const render = () => {
      const muted = sound.isMuted();
      button.toggleAttribute("data-muted", muted);
      button.setAttribute("aria-pressed", String(!muted));
      button.title = `${muted ? "Turn sound on" : "Turn sound off"} (press M)`;
    };
    render();
    // Let the first state paint before anything can animate.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => (button.dataset.ready = "")),
    );
    sound.subscribe(render);
    button.addEventListener("click", () => sound.toggle());
  }
</script>
