---
interface Props {
  /** Icon size in px. */
  size?: number;
  class?: string;
}

const { size = 18, class: className } = Astro.props;

/**
 * Hand-drawn wireframe marks. Every shape is an open <path> of shallow
 * beziers — no primitives, no closures, endpoints that miss or overshoot.
 * Curves are bowed slightly off-axis so strokes read as hand tremor.
 */
const icons = [
  {
    name: "x",
    label: "X / Twitter",
    href: "https://x.com/pyjeebz",
    rotate: "-rotate-3",
    strokes: [
      // Two crossing marker strokes, each bowed a touch off perfect diagonal.
      "M4.6 3.4 C8.9 8.3 14.3 14.2 19.7 20.3",
      "M19.9 3.2 C15.2 8.6 9.7 14.6 4.3 20.5",
    ],
  },
  {
    name: "github",
    label: "GitHub",
    href: "https://github.com/pyjeebz",
    rotate: "rotate-2",
    strokes: [
      // Face: one open arc down the sides and under the chin — top left open for the ears.
      "M5.1 5.7 C4.3 7.1 3.8 8.5 3.9 10.1 C4.1 13.5 6.8 15.8 12 15.8 C17.2 15.8 19.9 13.5 20.1 10.1 C20.2 8.4 19.7 7 18.9 5.6",
      // Ears drawn as separate little strokes that overshoot the head line.
      "M5.1 5.7 C4.7 4.4 4.6 3.1 4.8 2.1 C6 2.3 7 2.9 7.7 3.9",
      "M18.9 5.6 C19.3 4.3 19.4 3.1 19.2 2.1 C18 2.3 17 2.9 16.3 3.9",
      // Eyes: two short pressed-then-lifted pen ticks.
      "M8.9 9 C9.2 8.7 9.3 8.7 9.6 9",
      "M14.5 9 C14.8 8.7 14.9 8.7 15.2 9",
    ],
  },
  {
    name: "linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/mujeeb-lawal-saka/",
    rotate: "-rotate-2",
    strokes: [
      // Frame drawn in two lapping strokes that just miss each other at the corners.
      "M5.6 4.1 C10.5 3.6 15.4 3.5 19.5 4 C20.2 8.8 20.3 14 19.9 19.3",
      "M19.7 19.6 C14.4 19.9 9 20 4.5 19.6 C4.1 14.4 4 9.4 4.4 4.6",
      // i — a wobbly dot and a stem that drifts slightly as it falls.
      "M7.9 8.5 C8.1 8.1 8.6 8.2 8.5 8.6 C8.4 8.9 7.9 8.8 7.9 8.5",
      "M8.2 10.9 C8.1 12.9 8.1 15 8.3 17",
      // n — stem, then an arch that leans a little on its way down.
      "M11.5 16.9 C11.4 14.9 11.4 12.9 11.6 10.9",
      "M11.6 12 C12.1 10.9 13.1 10.3 14.2 10.5 C15.5 10.8 16.2 11.9 16.3 13.4 C16.3 14.6 16.3 15.7 16.4 16.7",
    ],
  },
  {
    name: "email",
    label: "Email",
    href: "mailto:lawalsakamujeeb@gmail.com",
    rotate: "rotate-3",
    strokes: [
      // Envelope sketched in one open loop, ends overlapping at the top-left.
      "M4.2 6.1 C9.4 5.6 14.9 5.5 19.7 6 C20.2 9.6 20.3 14.2 19.9 19.3 C14.5 18.7 9 18.7 4.3 19.2 C3.8 14.4 3.9 9.5 4.2 6.3",
      // Flap drawn as one sagging sweep that overshoots both walls.
      "M4.7 6.6 C8.7 10.1 14.7 10.3 19.3 6.1",
    ],
  },
];
---

<div class:list={["flex items-center gap-5", className]}>
  {
    icons.map(({ name, label, href, rotate, strokes }) => (
      <a
        href={href}
        target={name === "email" ? undefined : "_blank"}
        rel={name === "email" ? "noreferrer" : "noopener noreferrer"}
        aria-label={label}
        title={label}
        class:list={[
          "inline-block text-muted-faint transition-transform hover:-translate-y-1 hover:scale-110",
          rotate,
        ]}
      >
        <svg
          width={size}
          height={size}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {strokes.map((d) => (
            <path d={d} />
          ))}
        </svg>
      </a>
    ))
  }
</div>