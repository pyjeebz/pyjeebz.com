---
// Light/dark toggle. Preference is restored pre-paint in Layout's head script.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle light and dark theme"
  data-theme-toggle
>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.querySelector("[data-theme-toggle]");
    if (!btn || !window.__pjTheme) return;
    var sync = function () {
      btn.setAttribute("aria-pressed", window.__pjTheme.isLight() ? "true" : "false");
    };
    sync();
    btn.addEventListener("click", function () {
      window.__pjTheme.toggle();
      sync();
    });
  })();
</script>
