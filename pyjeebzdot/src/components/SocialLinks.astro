---
const links = [
  { label: "gh", href: "https://github.com/pyjeebz" },
  { label: "x", href: "https://x.com/pyjeebz" },
  { label: "in", href: "https://www.linkedin.com/in/mujeeb-lawal-saka/" },
  { label: "email", href: "mailto:lawalsakamujeeb@gmail.com" },
];
---

<p class="flex flex-wrap items-center gap-x-5 gap-y-2 font-sans text-[13px] text-muted">
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noreferrer"
        class="hover:text-off-white transition-colors"
      >
        {link.label}
      </a>
    ))
  }
</p>
